# ==============================================================================
# Cafe ERP System - Root Environment Variables Template
# Copy this file to .env or .env_database and fill with your actual configuration
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cafe_erp
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Backend API Configuration
APP_NAME="Cafe ERP System"
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRE_HOURS=24

# Redis Configuration (Optional - for distributed caching & pub/sub)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_TITLE="Cafe ERP Management System"

